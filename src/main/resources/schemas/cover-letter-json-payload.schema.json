{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CoverLetterJsonPayload",
  "type": "object",
  "properties": {
    "candidateName": { "type": "string", "minLength": 1 },
    "recipientCompany": { "type": "string" },
    "jobTitle": { "type": "string" },
    "salutation": { "type": "string", "minLength": 1 },
    "bodyParagraphs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": { "type": "string", "minLength": 1 }
    },
    "closing": { "type": "string", "minLength": 1 }
  },
  "required": ["candidateName", "salutation", "bodyParagraphs", "closing"],
  "additionalProperties": false
}
